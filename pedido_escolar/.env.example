# ==============================================================================
# SEVEN PEDIDOS ESCOLARES — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Public Frontend Variables (SAFE TO EXPOSE TO BROWSER)
# Only variables prefixed with VITE_ will be bundled into the client application.
# NEVER put private API secrets, tokens, or service-role keys in VITE_* variables.
# ==============================================================================

# Supabase Public Anonymous Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key...

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development

# Store Public Information
VITE_STORE_NAME="SEVEN MALHARIA"
VITE_STORE_WHATSAPP="+5596991605151"
VITE_STORE_ADDRESS="Avenida Professora Cora de Carvalho, 2042-B, Centro, atrás do SENAI"

# ==============================================================================
# SERVER-SIDE & SUPABASE EDGE FUNCTIONS ONLY (NEVER EXPOSE IN FRONTEND / VITE_*)
# These variables are read exclusively by server functions, backend workers, and webhooks.
# ==============================================================================

# Supabase Admin / Service Role Key (Server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-admin-key...

# Banco do Brasil PIX API (Production Server Secrets)
BB_PIX_CLIENT_ID=your_bb_client_id_here
BB_PIX_CLIENT_SECRET=your_bb_client_secret_here
BB_PIX_DEVELOPER_KEY=your_bb_developer_key_here
BB_PIX_CERTIFICATE_PATH=/etc/ssl/certs/bb_mtls.pem
BB_PIX_SANDBOX=false
BB_PIX_WEBHOOK_HMAC_SECRET=your_hmac_webhook_secret_here

# WhatsApp Gateway (Production Server Secrets - Evolution / Z-API / Meta Cloud)
WHATSAPP_API_URL=https://api.whatsapp-gateway.com/v1
WHATSAPP_API_TOKEN=your_secure_whatsapp_bearer_token_here
